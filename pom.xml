<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/>
    </parent>

    <groupId>ar.utn.donatrack</groupId>
    <artifactId>donatrack</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>
    <name>DonaTrack</name>
    <description>Sistema de Gestión y Trazabilidad de Donaciones - TP Anual DSI 2026</description>

    <modules>
        <module>plataforma/contratos</module>
        <module>plataforma/observabilidad</module>
        <module>plataforma/soporte</module>
        <module>infraestructura-local/broker</module>
        <module>servicios/autenticacion</module>
        <module>servicios/notificaciones</module>
        <module>servicios/donaciones</module>
        <module>servicios/logistica</module>
        <module>servicios/incentivos</module>
        <module>externos/planificador-rutas</module>
        <module>front</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <springdoc.version>2.8.17</springdoc.version>
        <flapdoodle.spring.version>4.24.0</flapdoodle.spring.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>ar.utn.donatrack</groupId>
                <artifactId>contratos</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ar.utn.donatrack</groupId>
                <artifactId>observabilidad</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>ar.utn.donatrack</groupId>
                <artifactId>soporte</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springdoc</groupId>
                <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
                <version>${springdoc.version}</version>
            </dependency>
            <dependency>
                <groupId>de.flapdoodle.embed</groupId>
                <artifactId>de.flapdoodle.embed.mongo.spring3x</artifactId>
                <version>${flapdoodle.spring.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
